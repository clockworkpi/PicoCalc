+	.get_ownership = picocalc_get_ownership,
+	.sysfs_ops = &kobj_sysfs_ops
+};
+
+int sysfs_probe(struct i2c_client* i2c_client)
+{
+	int rc;
+
+	// Allocate custom sysfs type
+	if ((picocalc_kobj = devm_kzalloc(&i2c_client->dev, sizeof(*picocalc_kobj), GFP_KERNEL)) == NULL) {
+		return -ENOMEM;
+	}
+
+	// Create sysfs entries for picocalc with custom type
+	rc = kobject_init_and_add(picocalc_kobj, &picocalc_ktype, firmware_kobj, "picocalc");
+	if (rc < 0) {
+		kobject_put(picocalc_kobj);
+		return rc;
+	}
+
+	// Create sysfs attributes
+	if (sysfs_create_group(picocalc_kobj, &picocalc_attr_group)) {
+		kobject_put(picocalc_kobj);
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+void sysfs_shutdown(struct i2c_client* i2c_client)
+{
+	// Remove sysfs entry
+	if (picocalc_kobj) {
+		kobject_put(picocalc_kobj);
+		picocalc_kobj = NULL;
+	}
+}
+
+static int picocalc_kbd_probe
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+(struct i2c_client* i2c_client, struct i2c_device_id const* i2c_id)
+#else
+(struct i2c_client* i2c_client)
+#endif
+{
+	int rc;
+
+	// Initialize key handler system
+	if ((rc = input_probe(i2c_client))) {
+		return rc;
+	}
+
+	// Initialize module parameters
+    /*
+	if ((rc = params_probe())) {
+		return rc;
+	}
+    */
+
+	// Initialize sysfs interface
+	if ((rc = sysfs_probe(i2c_client))) {
+		return rc;
+	}
+
+	return 0;
+}
+
+static void picocalc_kbd_shutdown(struct i2c_client* i2c_client)
+{
+	sysfs_shutdown(i2c_client);
+//	params_shutdown();
+	input_shutdown(i2c_client);
+}
+
+static void picocalc_kbd_remove(struct i2c_client* i2c_client)
+{
+	dev_info_fe(&i2c_client->dev,
+		"%s Removing picocalc-kbd.\n", __func__);
+
+	picocalc_kbd_shutdown(i2c_client);
+}
+
+// Driver definitions
+
+// Device IDs
+static const struct i2c_device_id picocalc_kbd_i2c_device_id[] = {
+	{ "picocalc_kbd", 0, },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, picocalc_kbd_i2c_device_id);
+static const struct of_device_id picocalc_kbd_of_device_id[] = {
+	{ .compatible = "picocalc_kbd", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, picocalc_kbd_of_device_id);
+
+// Callbacks
+static struct i2c_driver picocalc_kbd_driver = {
+	.driver = {
+		.name = "picocalc_kbd",
+		.of_match_table = picocalc_kbd_of_device_id,
+	},
+	.probe    = picocalc_kbd_probe,
+	.shutdown = picocalc_kbd_shutdown,
+	.remove   = picocalc_kbd_remove,
+	.id_table = picocalc_kbd_i2c_device_id,
+};
+
+////---------------------------------------------Battery 
+#define BATTERY_FULL_DESIGN 4000000 // μWh
+
+static enum power_supply_property pc_battery_props[] = {
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_TYPE,
+	POWER_SUPPLY_PROP_ENERGY_NOW,
+	POWER_SUPPLY_PROP_ENERGY_FULL,
+	POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN,
+};
+
+void pc_battery_update(struct kbd_ctx *ctx) {
+	read_battery_percent();
+	power_supply_changed(ctx->pc_battery_psy);
+}
+
+static int pc_battery_get_property(struct power_supply *psy,
+                                   enum power_supply_property psp,
+                                   union power_supply_propval *val)
+{
+
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = g_ctx->bat_percent;
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		if(g_ctx->bat_status) {
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		}else{
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		}
+		break;
+	case POWER_SUPPLY_PROP_TYPE:
+		val->intval = POWER_SUPPLY_TYPE_BATTERY;
+		break;
+	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
+	case POWER_SUPPLY_PROP_ENERGY_FULL:
+		val->intval = BATTERY_FULL_DESIGN;
+		break;
+	case POWER_SUPPLY_PROP_ENERGY_NOW:
+		val->intval = (g_ctx->bat_percent * BATTERY_FULL_DESIGN) / 100;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+
+
+
+}
+
+static const struct power_supply_desc my_battery_desc = {
+    .name = "BAT0",
+    .type = POWER_SUPPLY_TYPE_BATTERY,
+    .properties = pc_battery_props,
+    .num_properties = ARRAY_SIZE(pc_battery_props),
+    .get_property = pc_battery_get_property,
+};
+
+
+int picocalc_battery_probe(void)
+{
+    struct power_supply_config psy_cfg = {};
+    g_ctx->pc_battery_psy = power_supply_register(NULL, &my_battery_desc, &psy_cfg);
+    return PTR_ERR_OR_ZERO(g_ctx->pc_battery_psy);
+}
+
+
+static int shutdown_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	
+	int rc;
+	if (action == SYS_POWER_OFF || action == SYS_HALT ) {
+		pr_info("picocalc_kbd: sending shutdown command to keyboard\n");
+
+		if ((rc = kbd_write_i2c_u8(g_ctx->i2c_client, REG_ID_OFF,0x07)) < 0) {
+			pr_err("Failed to send shutdown cmd to picocalc kbd: %d\n", rc);
+                	return rc;
+        	}
+	}
+	
+	if (action == SYS_RESTART){
+		pr_info("picocalc_kbd: sending reset command to keyboard\n");
+		if ((rc = kbd_write_i2c_u8(g_ctx->i2c_client, REG_ID_RST,0x01)) < 0) {
+                        pr_err("Failed to send reset cmd to picocalc kbd: %d\n", rc);
+                        return rc;
+                }
+	}
+	return NOTIFY_DONE;
+}
+
+
+static struct notifier_block shutdown_notifier = {
+        .notifier_call = shutdown_notify,
+        .priority = 0,
+};
+
+////////////////////////////////////////////////////////////////////////Screen backlight
+
+
+static int pcbl_update_status(struct backlight_device *bl)
+{
+	struct backlight_properties *props = &bl->props;
+	int brightness = props->brightness;
+	u8 val = brightness;  // 0~255 brightness
+	int ret;
+
+	if (backlight_is_blank(bl))
+		val = 0;
+
+	if ((ret = kbd_write_i2c_u8(g_ctx->i2c_client, REG_ID_BKL,val)) < 0) {
+        	pr_err("Failed to update picocalc lcd backlight: %d\n", ret);
+        }
+
+	return ret;
+}
+
+static int pcbl_get_brightness(struct backlight_device *bl)
+{
+	uint8_t data[2];
+	int rc;
+
+	if ((rc = kbd_read_i2c_2u8(g_ctx->i2c_client, REG_ID_BKL,
+                        (uint8_t*)&data))) {
+            dev_err(&g_ctx->i2c_client->dev,
+                   "%s Could not read REG_ID_BKL, Error: %d\n", __func__, rc);
+
+	}
+
+	return data[1];
+}
+
+static const struct backlight_ops pcbl_ops = {
+	.update_status = pcbl_update_status,
+	.get_brightness = pcbl_get_brightness, 
+};
+
+static int pcbl_probe(void)
+{
+	struct backlight_properties props;
+	struct backlight_device *bl;
+	struct i2c_client *client;
+
+	client = g_ctx->i2c_client;
+
+	memset(&props, 0, sizeof(props));
+	props.type = BACKLIGHT_RAW;
+	props.max_brightness = 255;
+
+	bl = devm_backlight_device_register(&client->dev, "picocalc_lcd_backlight", &client->dev, g_ctx, &pcbl_ops, &props);
+	if (IS_ERR(bl))
+		return PTR_ERR(bl);
+
+	bl->props.brightness = 128;
+	bl->props.power = FB_BLANK_UNBLANK;
+
+	backlight_update_status(bl);
+
+	return 0;
+}
+
+
+
+// Module constructor
+static int __init picocalc_kbd_init(void)
+{
+	int rc;
+
+	// Adding the I2C driver will call the _probe function to continue setup
+	if ((rc = i2c_add_driver(&picocalc_kbd_driver))) {
+		pr_err("%s Could not initialise picocalc-kbd! Error: %d\n",
+			__func__, rc);
+		return rc;
+	}
+	pr_info("%s Initalised picoclac_kbd.\n", __func__);
+		
+	register_reboot_notifier(&shutdown_notifier);
+
+	pr_info("%s Initalised picoclac_kbd shutdown_notifier.\n", __func__);
+
+	pcbl_probe();
+
+	pr_info("%s Initalised picoclac_kbd lcd backlight.\n", __func__);
+
+	return rc;
+}
+module_init(picocalc_kbd_init);
+
+// Module destructor
+static void __exit picocalc_kbd_exit(void)
+{
+	pr_info("%s Exiting picocalc_kbd.\n", __func__);
+	i2c_del_driver(&picocalc_kbd_driver);
+	
+	power_supply_unregister(g_ctx->pc_battery_psy);
+	unregister_reboot_notifier(&shutdown_notifier);
+	
+}
+module_exit(picocalc_kbd_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("hiro <hiro@hiro.com>");
+MODULE_DESCRIPTION("keyboard driver for picocalc");
+MODULE_VERSION("0.01");
