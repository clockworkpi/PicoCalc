diff --git a/drivers/gpu/drm/tiny/picocalc_ili9488_drm.c b/drivers/gpu/drm/tiny/picocalc_ili9488_drm.c
new file mode 100644
index 000000000..c06907c98
--- /dev/null
+++ b/drivers/gpu/drm/tiny/picocalc_ili9488_drm.c
@@ -0,0 +1,812 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/iosys-map.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/random.h>
+#include <linux/spi/spi.h>
+#include <linux/version.h>
+
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_damage_helper.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_gem_atomic_helper.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_mipi_dbi.h>
+#include <drm/drm_modes.h>
+#include <video/mipi_display.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_fbdev_dma.h>
+#else
+#include <drm/drm_fb_helper.h>
+#endif
+
+#define PICOCALC_WIDTH 320
+#define PICOCALC_HEIGHT 320
+#define PICOCALC_BYTES_PER_PIXEL 3
+#define PICOCALC_SPAN_MERGE_GAP 3
+#define PICOCALC_WINDOW_OVERHEAD 11
+#define PICOCALC_TX_BUFFER_SIZE 4095
+
+static bool debug;
+module_param(debug, bool, 0644);
+MODULE_PARM_DESC(debug, "Enable verbose PicoCalc ILI9488 diagnostics");
+
+static bool test_pattern;
+module_param(test_pattern, bool, 0644);
+MODULE_PARM_DESC(test_pattern,
+		 "Send kernel-generated RGB666 random noise instead of the DRM framebuffer");
+
+#define picocalc_dbg(dev, fmt, ...)					\
+	do {								\
+		if (debug)						\
+			dev_info(dev, fmt, ##__VA_ARGS__);		\
+	} while (0)
+
+struct picocalc_rect {
+	u16 x1;
+	u16 x2;
+	u16 y1;
+	u16 y2;
+};
+
+struct picocalc_ili9488 {
+	struct mipi_dbi_dev *dbidev;
+	u32 *previous_frame;
+	struct picocalc_rect *rects;
+	struct picocalc_rect *row_spans;
+	unsigned int *active_rects;
+	unsigned int *next_active_rects;
+	unsigned int max_rects;
+	size_t tx_buf_size;
+	bool frame_valid;
+};
+
+static int picocalc_map_framebuffer(struct drm_framebuffer *fb,
+				    struct iosys_map *map,
+				    struct iosys_map *data)
+{
+	int ret;
+
+	ret = drm_gem_fb_begin_cpu_access(fb, DMA_FROM_DEVICE);
+	if (ret)
+		return ret;
+
+	ret = drm_gem_fb_vmap(fb, map, data);
+	if (ret)
+		drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
+
+	return ret;
+}
+
+static void picocalc_unmap_framebuffer(struct drm_framebuffer *fb,
+				       struct iosys_map *map)
+{
+	drm_gem_fb_vunmap(fb, map);
+	drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
+}
+
+static const struct drm_display_mode picocalc_mode = {
+	DRM_MODE_INIT(60, PICOCALC_WIDTH, PICOCALC_HEIGHT, 64, 64),
+};
+
+static int picocalc_send_window(struct mipi_dbi *dbi,
+				const struct picocalc_rect *rect)
+{
+	int ret;
+
+	ret = mipi_dbi_command(dbi, MIPI_DCS_SET_COLUMN_ADDRESS,
+			       rect->x1 >> 8, rect->x1 & 0xff,
+			       (rect->x2 - 1) >> 8, (rect->x2 - 1) & 0xff);
+	if (ret)
+		return ret;
+
+	return mipi_dbi_command(dbi, MIPI_DCS_SET_PAGE_ADDRESS,
+				rect->y1 >> 8, rect->y1 & 0xff,
+				(rect->y2 - 1) >> 8, (rect->y2 - 1) & 0xff);
+}
+
+static int picocalc_send_pixels(struct mipi_dbi *dbi, const u8 *pixels,
+				size_t len, u8 *cmd)
+{
+	int ret = mipi_dbi_command_buf(dbi, *cmd, (u8 *)pixels, len);
+
+	if (!ret) {
+		picocalc_dbg(&dbi->spi->dev,
+			     "pixel transfer cmd=0x%02x bytes=%zu ok\n",
+			     *cmd, len);
+		*cmd = MIPI_DCS_WRITE_MEMORY_CONTINUE;
+	} else {
+		dev_err(&dbi->spi->dev,
+			"pixel transfer cmd=0x%02x bytes=%zu failed: %d\n",
+			*cmd, len, ret);
+	}
+
+	return ret;
+}
+
+static int picocalc_send_test_pattern(struct picocalc_ili9488 *priv)
+{
+	struct mipi_dbi_dev *dbidev = priv->dbidev;
+	u8 *tx = (u8 *)dbidev->tx_buf;
+	u8 cmd = MIPI_DCS_WRITE_MEMORY_START;
+	size_t remaining = (size_t)PICOCALC_WIDTH * PICOCALC_HEIGHT;
+	unsigned int x;
+	int ret;
+
+	ret = picocalc_send_window(&dbidev->dbi,
+				   &(struct picocalc_rect) {
+					   .x1 = 0,
+					   .x2 = PICOCALC_WIDTH,
+					   .y1 = 0,
+					   .y2 = PICOCALC_HEIGHT,
+				   });
+	if (ret)
+		return ret;
+
+	while (remaining) {
+		size_t pixels = min(remaining, priv->tx_buf_size /
+						 PICOCALC_BYTES_PER_PIXEL);
+
+		for (x = 0; x < pixels; x++) {
+			u32 random = get_random_u32();
+			size_t offset = x * PICOCALC_BYTES_PER_PIXEL;
+
+			tx[offset] = random & 0xfc;
+			tx[offset + 1] = (random >> 8) & 0xfc;
+			tx[offset + 2] = (random >> 16) & 0xfc;
+		}
+
+		ret = picocalc_send_pixels(&dbidev->dbi, tx,
+					   pixels * PICOCALC_BYTES_PER_PIXEL,
+					   &cmd);
+		if (ret)
+			return ret;
+		remaining -= pixels;
+	}
+
+	return 0;
+}
+
+static int picocalc_flush_rect(struct picocalc_ili9488 *priv,
+			      struct iosys_map *src,
+			      struct drm_framebuffer *fb,
+			      const struct picocalc_rect *rect)
+{
+	struct mipi_dbi_dev *dbidev = priv->dbidev;
+	u32 row[PICOCALC_WIDTH];
+	u8 *tx = (u8 *)dbidev->tx_buf;
+	u8 cmd = MIPI_DCS_WRITE_MEMORY_START;
+	size_t pos = 0;
+	unsigned int x, y;
+	int ret;
+
+	ret = picocalc_send_window(&dbidev->dbi, rect);
+	if (ret) {
+		dev_err(dbidev->drm.dev,
+			"failed to set window x=%u..%u y=%u..%u: %d\n",
+			rect->x1, rect->x2, rect->y1, rect->y2, ret);
+		return ret;
+	}
+	picocalc_dbg(dbidev->drm.dev,
+		     "flush rect x=%u..%u y=%u..%u\n",
+		     rect->x1, rect->x2, rect->y1, rect->y2);
+
+	for (y = rect->y1; y < rect->y2; y++) {
+		size_t offset = (size_t)y * fb->pitches[0] +
+				(size_t)rect->x1 * sizeof(u32);
+
+		iosys_map_memcpy_from(row, src, offset,
+				      (rect->x2 - rect->x1) * sizeof(u32));
+
+		for (x = rect->x1; x < rect->x2; x++) {
+			u32 pixel = row[x - rect->x1];
+			size_t index = (size_t)y * PICOCALC_WIDTH + x;
+
+			tx[pos++] = (pixel >> 16) & 0xfc;
+			tx[pos++] = (pixel >> 8) & 0xfc;
+			tx[pos++] = pixel & 0xfc;
+			priv->previous_frame[index] = pixel & 0x00ffffff;
+
+			if (pos == priv->tx_buf_size) {
+				ret = picocalc_send_pixels(&dbidev->dbi, tx,
+							   pos, &cmd);
+				if (ret)
+					return ret;
+				pos = 0;
+			}
+		}
+	}
+
+	if (!pos)
+		return 0;
+
+	return picocalc_send_pixels(&dbidev->dbi, tx, pos, &cmd);
+}
+
+static int picocalc_build_rects(struct picocalc_ili9488 *priv,
+				struct iosys_map *src,
+				struct drm_framebuffer *fb,
+				const struct drm_rect *clip,
+				unsigned int *rect_count)
+{
+	u32 row[PICOCALC_WIDTH];
+	unsigned int active_count = 0;
+	unsigned int y;
+
+	*rect_count = 0;
+
+	for (y = clip->y1; y < clip->y2; y++) {
+		unsigned int span_count = 0;
+		unsigned int active_pos = 0;
+		unsigned int next_active_count = 0;
+		unsigned int x;
+		int start = -1;
+		int last_changed = -1;
+		size_t offset = (size_t)y * fb->pitches[0] +
+				(size_t)clip->x1 * sizeof(u32);
+
+		iosys_map_memcpy_from(row, src, offset,
+				      (clip->x2 - clip->x1) * sizeof(u32));
+
+		for (x = clip->x1; x < clip->x2; x++) {
+			size_t index = (size_t)y * PICOCALC_WIDTH + x;
+			bool changed = !priv->frame_valid ||
+				       ((row[x - clip->x1] & 0x00ffffff) !=
+					priv->previous_frame[index]);
+
+			if (changed) {
+				if (start < 0)
+					start = x;
+				last_changed = x;
+			} else if (start >= 0 &&
+				   x - last_changed > PICOCALC_SPAN_MERGE_GAP) {
+				priv->row_spans[span_count++] =
+					(struct picocalc_rect) {
+						.x1 = start,
+						.x2 = last_changed + 1,
+					};
+				start = -1;
+			}
+		}
+
+		if (start >= 0)
+			priv->row_spans[span_count++] =
+				(struct picocalc_rect) {
+					.x1 = start,
+					.x2 = last_changed + 1,
+				};
+
+		for (x = 0; x < span_count; x++) {
+			struct picocalc_rect *span = &priv->row_spans[x];
+			unsigned int rect_index;
+
+			while (active_pos < active_count &&
+			       priv->rects[priv->active_rects[active_pos]].x1 <
+				       span->x1)
+				active_pos++;
+
+			if (active_pos < active_count) {
+				rect_index = priv->active_rects[active_pos];
+				if (priv->rects[rect_index].x1 == span->x1) {
+					active_pos++;
+					if (priv->rects[rect_index].x2 == span->x2) {
+						priv->rects[rect_index].y2 = y + 1;
+						priv->next_active_rects[next_active_count++] =
+							rect_index;
+						continue;
+					}
+				}
+			}
+
+			if (*rect_count >= priv->max_rects)
+				return -EOVERFLOW;
+
+			rect_index = (*rect_count)++;
+			priv->rects[rect_index] = (struct picocalc_rect) {
+				.x1 = span->x1,
+				.x2 = span->x2,
+				.y1 = y,
+				.y2 = y + 1,
+			};
+			priv->next_active_rects[next_active_count++] = rect_index;
+		}
+
+		swap(priv->active_rects, priv->next_active_rects);
+		active_count = next_active_count;
+	}
+
+	return 0;
+}
+
+static int picocalc_flush_damage(struct picocalc_ili9488 *priv,
+				 struct iosys_map *src,
+				 struct drm_framebuffer *fb,
+				 struct drm_rect *clip)
+{
+	struct picocalc_rect full = {
+		.x1 = clip->x1,
+		.x2 = clip->x2,
+		.y1 = clip->y1,
+		.y2 = clip->y2,
+	};
+	u64 update_cost = 0;
+	u64 full_cost;
+	unsigned int rect_count, i;
+	int ret;
+
+	if (!priv->frame_valid) {
+		priv->rects[0] = full;
+		rect_count = 1;
+	} else {
+		ret = picocalc_build_rects(priv, src, fb, clip, &rect_count);
+		if (ret)
+			return ret;
+		if (!rect_count)
+			return 0;
+	}
+
+	for (i = 0; i < rect_count; i++) {
+		const struct picocalc_rect *rect = &priv->rects[i];
+		u64 pixels = (u64)(rect->x2 - rect->x1) *
+			     (rect->y2 - rect->y1);
+
+		update_cost += pixels * PICOCALC_BYTES_PER_PIXEL +
+			       PICOCALC_WINDOW_OVERHEAD;
+	}
+
+	full_cost = (u64)(clip->x2 - clip->x1) *
+		    (clip->y2 - clip->y1) * PICOCALC_BYTES_PER_PIXEL +
+		    PICOCALC_WINDOW_OVERHEAD;
+	if (update_cost >= full_cost) {
+		priv->rects[0] = full;
+		rect_count = 1;
+	}
+
+	for (i = 0; i < rect_count; i++) {
+		ret = picocalc_flush_rect(priv, src, fb, &priv->rects[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static void picocalc_enable(struct drm_simple_display_pipe *pipe,
+			    struct drm_crtc_state *crtc_state,
+			    struct drm_plane_state *plane_state)
+{
+	struct mipi_dbi_dev *dbidev = drm_to_mipi_dbi_dev(pipe->crtc.dev);
+	struct picocalc_ili9488 *priv = dbidev->driver_private;
+	struct drm_framebuffer *fb = plane_state->fb;
+	struct iosys_map map[1] = { };
+	struct iosys_map data[1] = { };
+	struct drm_rect full = {
+		.x1 = 0,
+		.x2 = fb->width,
+		.y1 = 0,
+		.y2 = fb->height,
+	};
+	struct mipi_dbi *dbi = &dbidev->dbi;
+	int ret, idx;
+
+	picocalc_dbg(dbidev->drm.dev,
+		     "pipe enable requested; fb=%ux%u format=%p4cc pitch=%u rotation=%u\n",
+		     fb->width, fb->height, &fb->format->format,
+		     fb->pitches[0], dbidev->rotation);
+
+	if (!drm_dev_enter(pipe->crtc.dev, &idx)) {
+		dev_err(dbidev->drm.dev,
+			"pipe enable aborted: DRM device is unplugged\n");
+		return;
+	}
+
+	priv->frame_valid = false;
+	ret = mipi_dbi_poweron_conditional_reset(dbidev);
+	picocalc_dbg(dbidev->drm.dev,
+		     "conditional power-on reset returned %d\n", ret);
+	if (ret < 0) {
+		dev_err(dbidev->drm.dev,
+			"panel power-on/reset failed: %d\n", ret);
+		goto out;
+	}
+
+	ret = mipi_dbi_command(dbi, 0xe0,
+				       0x00, 0x03, 0x09, 0x08, 0x16,
+				       0x0a, 0x3f, 0x78, 0x4c, 0x09,
+				       0x0a, 0x08, 0x16, 0x1a, 0x0f);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xe1,
+				       0x00, 0x16, 0x19, 0x03, 0x0f,
+				       0x05, 0x32, 0x45, 0x46, 0x04,
+				       0x0e, 0x0d, 0x35, 0x37, 0x0f);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xc0, 0x17, 0x15);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xc1, 0x41);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xc5, 0x00, 0x12, 0x80);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0x36, 0x48);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0x3a, 0x66);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xb0, 0x80);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xb1, 0xa0);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xb4, 0x02);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0x21);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xb6, 0x02, 0x02, 0x3b);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xb7, 0xc6);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0xf7, 0xa9, 0x51, 0x2c, 0x82);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0x11);
+	if (ret)
+		goto out;
+	msleep(120);
+	ret = mipi_dbi_command(dbi, 0x33,
+				       0x00, 0x00, 0x01, 0x40, 0x00, 0xa0);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0x29);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0x36);
+	if (ret)
+		goto out;
+	ret = mipi_dbi_command(dbi, 0x36, 0x48);
+	if (ret)
+		goto out;
+	picocalc_dbg(dbidev->drm.dev,
+		     "ILI9488 initialization sequence completed\n");
+
+	if (test_pattern) {
+		ret = picocalc_send_test_pattern(priv);
+		if (ret) {
+			dev_err(dbidev->drm.dev,
+				"kernel-generated color-bar transfer failed: %d\n",
+				ret);
+			goto out;
+		}
+		priv->frame_valid = true;
+		picocalc_dbg(dbidev->drm.dev,
+			     "kernel-generated RGB666 random noise sent; DRM framebuffer bypassed\n");
+		goto out;
+	}
+
+	priv->frame_valid = false;
+	ret = picocalc_map_framebuffer(fb, map, data);
+	if (ret) {
+		dev_err(dbidev->drm.dev,
+			"initial framebuffer map failed: %d\n", ret);
+		goto out;
+	}
+
+	ret = picocalc_flush_damage(priv, &data[0], fb, &full);
+	picocalc_unmap_framebuffer(fb, map);
+	if (ret) {
+		dev_err_ratelimited(dbidev->drm.dev,
+				    "initial framebuffer transfer failed: %d\n",
+				    ret);
+		goto out;
+	}
+	priv->frame_valid = true;
+	picocalc_dbg(dbidev->drm.dev,
+		     "initial full-frame transfer completed successfully\n");
+
+	if (dbidev->backlight) {
+		ret = backlight_enable(dbidev->backlight);
+		if (ret)
+			dev_err(dbidev->drm.dev,
+				"failed to enable backlight: %d\n", ret);
+	}
+out:
+	drm_dev_exit(idx);
+}
+
+static void picocalc_update(struct drm_simple_display_pipe *pipe,
+			    struct drm_plane_state *old_state)
+{
+	struct drm_plane_state *state = pipe->plane.state;
+	struct mipi_dbi_dev *dbidev = drm_to_mipi_dbi_dev(pipe->crtc.dev);
+	struct picocalc_ili9488 *priv = dbidev->driver_private;
+	struct drm_framebuffer *fb = state->fb;
+	struct drm_rect clip;
+	struct iosys_map map[1] = { };
+	struct iosys_map data[1] = { };
+	int ret, idx;
+
+	picocalc_dbg(dbidev->drm.dev,
+		     "pipe update requested; active=%u fb=%p frame_valid=%u\n",
+		     pipe->crtc.state->active, fb, priv->frame_valid);
+	if (test_pattern) {
+		picocalc_dbg(dbidev->drm.dev,
+			     "kernel test pattern active; skipping DRM framebuffer update\n");
+		return;
+	}
+	if (!pipe->crtc.state->active || !fb)
+		return;
+
+	if (!drm_dev_enter(fb->dev, &idx))
+		return;
+
+	if (priv->frame_valid) {
+		if (!drm_atomic_helper_damage_merged(old_state, state, &clip)) {
+			picocalc_dbg(dbidev->drm.dev,
+				     "pipe update has no damage; skipping transfer\n");
+			goto out;
+		}
+	} else {
+		clip = (struct drm_rect) {
+			.x1 = 0,
+			.x2 = fb->width,
+			.y1 = 0,
+			.y2 = fb->height,
+		};
+	}
+	picocalc_dbg(dbidev->drm.dev,
+		     "update clip x=%d..%d y=%d..%d\n",
+		     clip.x1, clip.x2, clip.y1, clip.y2);
+
+	ret = picocalc_map_framebuffer(fb, map, data);
+	if (ret) {
+		priv->frame_valid = false;
+		dev_err_ratelimited(dbidev->drm.dev,
+				    "framebuffer mapping failed: %d\n", ret);
+		goto out;
+	}
+
+	ret = picocalc_flush_damage(priv, &data[0], fb, &clip);
+	picocalc_unmap_framebuffer(fb, map);
+	if (ret) {
+		priv->frame_valid = false;
+		dev_err(dbidev->drm.dev,
+			"framebuffer transfer failed: %d\n", ret);
+	} else {
+		priv->frame_valid = true;
+		picocalc_dbg(dbidev->drm.dev,
+			     "pipe update completed successfully\n");
+	}
+out:
+	drm_dev_exit(idx);
+}
+
+static void picocalc_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct mipi_dbi_dev *dbidev = drm_to_mipi_dbi_dev(pipe->crtc.dev);
+
+	picocalc_dbg(dbidev->drm.dev,
+		     "pipe disabled; panel GRAM retained; backlight device=%s\n",
+		     dbidev->backlight ? "present" : "absent");
+	if (dbidev->backlight) {
+		int ret = backlight_disable(dbidev->backlight);
+
+		if (ret)
+			dev_err_ratelimited(dbidev->drm.dev,
+					    "failed to disable backlight: %d\n",
+					    ret);
+	}
+}
+
+static const struct drm_simple_display_pipe_funcs picocalc_pipe_funcs = {
+	.mode_valid = mipi_dbi_pipe_mode_valid,
+	.enable = picocalc_enable,
+	.disable = picocalc_disable,
+	.update = picocalc_update,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(picocalc_fops);
+
+static const struct drm_driver picocalc_drm_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops = &picocalc_fops,
+	DRM_GEM_DMA_DRIVER_OPS_VMAP,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+	DRM_FBDEV_DMA_DRIVER_OPS,
+#endif
+	.debugfs_init = mipi_dbi_debugfs_init,
+	.name = "picocalc-ili9488",
+	.desc = "PicoCalc ILI9488 SPI display",
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 14, 0)
+	.date = "20261027",
+#endif
+	.major = 1,
+	.minor = 0,
+};
+
+static const u32 picocalc_formats[] = {
+	DRM_FORMAT_XRGB8888,
+};
+
+static const struct of_device_id picocalc_of_match[] = {
+	{ .compatible = "cuu,picocalc-ili9488" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, picocalc_of_match);
+
+static const struct spi_device_id picocalc_spi_ids[] = {
+	{ "picocalc-ili9488" },
+	{ }
+};
+MODULE_DEVICE_TABLE(spi, picocalc_spi_ids);
+
+static void picocalc_free_buffer(void *data)
+{
+	kvfree(data);
+}
+
+static int picocalc_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct mipi_dbi_dev *dbidev;
+	struct picocalc_ili9488 *priv;
+	struct drm_device *drm;
+	struct gpio_desc *dc;
+	u32 rotation = 0;
+	size_t pixels = PICOCALC_WIDTH * PICOCALC_HEIGHT;
+	size_t tx_size;
+	size_t max_transfer;
+	int ret;
+
+	dbidev = devm_drm_dev_alloc(dev, &picocalc_drm_driver,
+				    struct mipi_dbi_dev, drm);
+	if (IS_ERR(dbidev))
+		return PTR_ERR(dbidev);
+
+	drm = &dbidev->drm;
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->dbidev = dbidev;
+	priv->max_rects = DIV_ROUND_UP(PICOCALC_WIDTH, 2) *
+			  PICOCALC_HEIGHT + 1;
+	dbidev->driver_private = priv;
+	drm->mode_config.preferred_depth = 24;
+
+	priv->previous_frame = kvcalloc(pixels, sizeof(*priv->previous_frame),
+					GFP_KERNEL);
+	if (!priv->previous_frame)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, picocalc_free_buffer,
+				       priv->previous_frame);
+	if (ret)
+		return ret;
+
+	priv->rects = kvcalloc(priv->max_rects, sizeof(*priv->rects),
+			       GFP_KERNEL);
+	if (!priv->rects)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, picocalc_free_buffer, priv->rects);
+	if (ret)
+		return ret;
+
+	priv->row_spans = devm_kcalloc(dev, PICOCALC_WIDTH,
+				       sizeof(*priv->row_spans), GFP_KERNEL);
+	priv->active_rects = devm_kcalloc(dev, PICOCALC_WIDTH,
+					  sizeof(*priv->active_rects),
+					  GFP_KERNEL);
+	priv->next_active_rects = devm_kcalloc(dev, PICOCALC_WIDTH,
+					       sizeof(*priv->next_active_rects),
+					       GFP_KERNEL);
+	if (!priv->row_spans || !priv->active_rects ||
+	    !priv->next_active_rects)
+		return -ENOMEM;
+
+	dbidev->dbi.reset = devm_gpiod_get_optional(dev, "reset",
+						    GPIOD_OUT_HIGH);
+	if (IS_ERR(dbidev->dbi.reset))
+		return dev_err_probe(dev, PTR_ERR(dbidev->dbi.reset),
+				     "failed to get reset GPIO\n");
+
+	dc = devm_gpiod_get(dev, "dc", GPIOD_OUT_LOW);
+	if (IS_ERR(dc))
+		return dev_err_probe(dev, PTR_ERR(dc),
+				     "failed to get D/C GPIO\n");
+
+	dbidev->backlight = devm_of_find_backlight(dev);
+	if (IS_ERR(dbidev->backlight))
+		return dev_err_probe(dev, PTR_ERR(dbidev->backlight),
+				     "failed to get backlight\n");
+
+	device_property_read_u32(dev, "rotation", &rotation);
+
+	ret = mipi_dbi_spi_init(spi, &dbidev->dbi, dc);
+	if (ret)
+		return ret;
+
+	/* ILI9488 RGB666 pixels are transmitted as three 8-bit components. */
+	dbidev->dbi.swap_bytes = true;
+
+	max_transfer = min(spi_max_transfer_size(spi),
+			   spi_max_message_size(spi));
+	tx_size = min_t(size_t, max_transfer, PICOCALC_TX_BUFFER_SIZE);
+	tx_size -= tx_size % PICOCALC_BYTES_PER_PIXEL;
+	if (tx_size < PICOCALC_BYTES_PER_PIXEL)
+		return dev_err_probe(dev, -EMSGSIZE,
+				     "SPI controller transfer limit is too small\n");
+	priv->tx_buf_size = tx_size;
+	picocalc_dbg(dev,
+		     "probe: SPI device=%s speed=%uHz mode=0x%x dc_gpio=present reset_gpio=%s tx_buf=%zu\n",
+		     dev_name(dev),
+		     spi->max_speed_hz, spi->mode,
+		     dbidev->dbi.reset ? "present" : "absent", tx_size);
+
+	ret = mipi_dbi_dev_init_with_formats(dbidev, &picocalc_pipe_funcs,
+					     picocalc_formats,
+					     ARRAY_SIZE(picocalc_formats),
+					     &picocalc_mode, rotation, tx_size);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	spi_set_drvdata(spi, drm);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+	drm_client_setup_with_fourcc(drm, DRM_FORMAT_XRGB8888);
+#else
+	drm_fbdev_generic_setup(drm, 32);
+#endif
+	picocalc_dbg(dev, "DRM device registered successfully\n");
+
+	return 0;
+}
+
+static void picocalc_remove(struct spi_device *spi)
+{
+	struct drm_device *drm = spi_get_drvdata(spi);
+
+	drm_dev_unplug(drm);
+	drm_atomic_helper_shutdown(drm);
+}
+
+static void picocalc_shutdown(struct spi_device *spi)
+{
+	drm_atomic_helper_shutdown(spi_get_drvdata(spi));
+}
+
+static struct spi_driver picocalc_spi_driver = {
+	.driver = {
+		.name = "picocalc-ili9488",
+		.of_match_table = picocalc_of_match,
+	},
+	.id_table = picocalc_spi_ids,
+	.probe = picocalc_probe,
+	.remove = picocalc_remove,
+	.shutdown = picocalc_shutdown,
+};
+module_spi_driver(picocalc_spi_driver);
+
+MODULE_DESCRIPTION("DRM/KMS driver for the PicoCalc ILI9488 SPI display");
+MODULE_AUTHOR("OpenAI");
+MODULE_LICENSE("GPL");
