@@ -0,0 +1,34 @@
+/dts-v1/;
+/plugin/;
+
+/ {
+    compatible = "brcm,bcm2835";
+
+   fragment@0 {
+                target = <&spidev0>;
+                __overlay__ {
+                        status = "disabled";
+                };
+   };
+
+    fragment@1 {
+        target = <&spi1>;
+        __overlay__ {
+            status = "okay";
+
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            sdslot@0 {
+                compatible = "mmc-spi-slot";
+                reg = <0>;                        // SPI CS0
+                voltage-ranges = <3300 3300>;
+                spi-max-frequency = <8000000>;
+                gpios = <&gpio 6 1>;
+                cd-gpios = <&gpio 6 1>;
+                /* interrupts-extended = <&gpio 6 8>; */
+
+            };
+        };
+    };
+};
