+/ {
+	compatible = "brcm,bcm2835";
+
+	fragment@0 {
+		target = <&spi0>;
+
+		__overlay__ {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			picocalc_ili9488: display@0 {
+				compatible = "cuu,picocalc-ili9488";
+				reg = <0>;
+				spi-max-frequency = <40000000>;
+				dc-gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
+				reset-gpios = <&gpio 5 GPIO_ACTIVE_HIGH>;
+				rotation = <0>;
+				status = "okay";
+			};
+		};
+	};
+};
