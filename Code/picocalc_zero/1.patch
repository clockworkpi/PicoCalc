+	[0x88] = KEY_F8,
+	[0x89] = KEY_F9,
+	[0x90] = KEY_F10,
+
+	['#'] = KEY_3,
+	['@'] = KEY_2,
+	[0x08] = KEY_BACKSPACE,
+	[0xD4] = KEY_DELETE,
+	[0xD5] = KEY_END,
+	[0xC1] = KEY_CAPSLOCK,
+	[0x09] = KEY_TAB,
+	[0xD2] = KEY_HOME,
+	[0xB1] = KEY_ESC,
+	[0xd0] = KEY_BREAK,
+	[0xd0] = KEY_PAUSE,
+	['='] = KEY_EQUAL,
+	['+'] = KEY_EQUAL,
+	['-'] = KEY_MINUS,
+	['_'] = KEY_MINUS,
+	['\\'] = KEY_BACKSLASH,
+	['|'] = KEY_BACKSLASH,
+	['!'] = KEY_1,
+	[0xD1] = KEY_INSERT,
+	['*'] = KEY_8,
+	['&'] = KEY_7,
+	['^'] = KEY_6,
+	['%'] = KEY_5,
+
+	['.'] = KEY_DOT,
+	['>'] = KEY_DOT,
+
+	[';'] = KEY_SEMICOLON,
+	[':'] = KEY_SEMICOLON,
+
+	[','] = KEY_COMMA,
+	['<'] = KEY_COMMA,
+
+	['`'] = KEY_GRAVE,
+	['~'] = KEY_GRAVE,
+
+	['"'] = KEY_APOSTROPHE,
+	['\''] = KEY_APOSTROPHE,
+
+	['?'] = KEY_SLASH,
+	['/'] = KEY_SLASH,
+
+	[')'] = KEY_0,
+	['('] = KEY_9,
+
+	[']'] = KEY_RIGHTBRACE,
+	['}'] = KEY_RIGHTBRACE,
+
+	['['] = KEY_LEFTBRACE,
+	['{'] = KEY_LEFTBRACE,
+
+	[0xb7] = KEY_RIGHT,
+	[0xb5] = KEY_UP,
+	[0xb6] = KEY_DOWN,
+	[0xb4] = KEY_LEFT,
+	[0xd6] = KEY_PAGEUP,
+	[0xd7] = KEY_PAGEDOWN,
+	[0x91] = KEY_POWER,
+};
+
+
+#endif
